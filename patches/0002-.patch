+    m_sendMonitor = new StreamSendMonitor("StreamProducer");
 }
 
 StreamProducer::~StreamProducer()
@@ -195,10 +195,10 @@ StreamProducer::~StreamProducer()
     m_distributeIdx = NULL;
     m_skewState = NULL;
     
-    // if (m_sendMonitor) {
-    //     delete m_sendMonitor;
-    //     m_sendMonitor = NULL;
-    // }
+    if (m_sendMonitor) {
+        delete m_sendMonitor;
+        m_sendMonitor = NULL;
+    }
 }
 
